# Local database and JWT
DB_URL=sqlite:///./local_data/local_dev.db
SECRET_KEY=change_me_local_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aura Assistant with Hugging Face HTTP
ASSISTANT_ENGINE=hf_rag
HF_TOKEN=hf_your_read_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions
HF_TIMEOUT_SECONDS=60
HF_MAX_TOKENS=300
HF_TEMPERATURE=0.3
HF_RAG_TOP_K=4

# Local RAG + Ollama demo (optional)
# ASSISTANT_ENGINE=rag_ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=120
# RAG_TOP_K=4
# RAG_COLLECTION=aura_assistant_docs
# RAG_CHROMA_DIR=chroma_db
